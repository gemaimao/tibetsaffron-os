}

.seal-icon {
  font-size: 18rpx;
}

/* ══════════════════════════════════════════════════════════════════
   8. 横屏大图模态窗
   ══════════════════════════════════════════════════════════════════ */
.landscape-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.96);
