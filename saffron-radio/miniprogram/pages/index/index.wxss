}

/* 演播室频道直通车卡片 */
.channel-switch-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  background: linear-gradient(135deg, rgba(229, 169, 93, 0.16) 0%, rgba(30, 20, 15, 0.45) 100%);
  border: 1rpx solid rgba(229, 169, 93, 0.45);
  border-radius: 16rpx;
  margin-bottom: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.35);
  transition: transform 0.15s ease;
}

.channel-switch-card:active {
  transform: scale(0.98);
  border-color: #e5a95d;
}

.channel-switch-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.channel-badge {
  display: inline-block;
  font-size: 13rpx;
  font-weight: 700;
  color: #e5a95d;
  background: rgba(229, 169, 93, 0.2);
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  width: fit-content;
  letter-spacing: 0.5rpx;
}

.channel-switch-title {
  font-size: 24rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 0.5rpx;
}

.channel-switch-desc {
  font-size: 16rpx;
  color: #cbd5e1;
}

.channel-switch-btn {
  font-size: 18rpx;
  font-weight: 700;
  color: #11141b;
  background: #e5a95d;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(229, 169, 93, 0.35);
  white-space: nowrap;
}

.drawer-scroll {
  max-height: 52vh;
  width: 100%;
}

.episode-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  margin-bottom: 14rpx;
  transition: all 0.2s ease;
}

.episode-item.item-active {
  background: linear-gradient(135deg, rgba(223, 178, 106, 0.18), rgba(184, 134, 54, 0.12));
  border-color: rgba(223, 178, 106, 0.5);
  box-shadow: 0 4rpx 18rpx rgba(223, 178, 106, 0.15);
}

.item-left {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  flex: 1;
  min-width: 0;
}

.item-ep-badge {
  background: linear-gradient(135deg, #dfb26a, #b88636);
  color: #070809;
  font-size: 16rpx;
  font-weight: 800;
  padding: 3rpx 10rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.item-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}

.item-title {
  font-size: 21rpx;
  font-weight: 700;
  color: #f1ede6;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-active .item-title {
  color: #e5b974;
}

.item-meta {
  font-size: 16rpx;
  color: #64748b;
}

.item-right {
  margin-left: 12rpx;
  flex-shrink: 0;
}

.now-playing-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(229, 185, 116, 0.2);
  border: 1rpx solid rgba(229, 185, 116, 0.4);
  color: #e5b974;
  font-size: 16rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.wave-dot {
  font-size: 12rpx;
  animation: blinkLive 1s infinite alternate;
}

.play-hint-btn {
  font-size: 16rpx;
  color: #94a3b8;
  background: rgba(255, 255, 255, 0.06);
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.lock-hint-btn {
  font-size: 15rpx;
  color: #64748b;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx dashed rgba(255, 255, 255, 0.12);
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

/* 🌟 录音与10秒收尾倒数 HUD 全局浮层 (60s Recording Limit & 10s Countdown) */
.recording-hud-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(10, 15, 28, 0.72);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
}

.recording-hud-card {
  width: 580rpx;
  padding: 48rpx 36rpx;
  background: linear-gradient(145deg, rgba(28, 36, 52, 0.95), rgba(16, 22, 34, 0.98));
  border: 1.5rpx solid rgba(229, 185, 116, 0.35);
  border-radius: 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.7), 0 0 40rpx rgba(229, 185, 116, 0.15);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.hud-warning-pulse {
  border-color: rgba(239, 68, 68, 0.8) !important;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.8), 0 0 50rpx rgba(239, 68, 68, 0.4) !important;
  animation: hudUrgentGlow 1s infinite alternate;
}

@keyframes hudUrgentGlow {
  0% { transform: scale(1); box-shadow: 0 0 25rpx rgba(239, 68, 68, 0.3); }
  100% { transform: scale(1.02); box-shadow: 0 0 55rpx rgba(239, 68, 68, 0.6); }
}

.hud-mic-ring {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(229, 185, 116, 0.25) 0%, rgba(229, 185, 116, 0.05) 70%);
  border: 2rpx solid rgba(229, 185, 116, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  animation: micRingPulse 1.6s infinite ease-out;
}

.mic-ring-urgent {
  background: radial-gradient(circle, rgba(239, 68, 68, 0.35) 0%, rgba(239, 68, 68, 0.08) 70%) !important;
  border-color: rgba(239, 68, 68, 0.8) !important;
  animation: micRingUrgentPulse 0.9s infinite ease-out !important;
}

@keyframes micRingPulse {
  0% { transform: scale(0.92); box-shadow: 0 0 0 0 rgba(229, 185, 116, 0.5); }
  70% { transform: scale(1.08); box-shadow: 0 0 0 24rpx rgba(229, 185, 116, 0); }
  100% { transform: scale(0.92); box-shadow: 0 0 0 0 rgba(229, 185, 116, 0); }
}

@keyframes micRingUrgentPulse {
  0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.6); }
  70% { transform: scale(1.12); box-shadow: 0 0 0 30rpx rgba(239, 68, 68, 0); }
  100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
}

.hud-mic-icon {
  font-size: 52rpx;
}

.hud-status-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #f1f5f9;
  letter-spacing: 1rpx;
  margin-bottom: 20rpx;
}

.hud-timer-badge {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(229, 185, 116, 0.3);
  padding: 10rpx 28rpx;
  border-radius: 40rpx;
  margin-bottom: 20rpx;
}

.timer-badge-urgent {
  background: rgba(239, 68, 68, 0.15) !important;
  border-color: rgba(239, 68, 68, 0.6) !important;
}

.hud-sec-num {
  font-size: 44rpx;
  font-weight: 900;
  color: #e5b974;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.timer-badge-urgent .hud-sec-num {
  color: #f87171 !important;
  animation: numBlink 0.5s infinite alternate;
}

@keyframes numBlink {
  0% { opacity: 0.7; }
  100% { opacity: 1; transform: scale(1.08); }
}

.hud-sec-unit {
  font-size: 22rpx;
  color: #94a3b8;
  font-weight: 500;
}

.hud-tip-txt {
  font-size: 20rpx;
  color: #64748b;
  letter-spacing: 0.5rpx;
}

/* 🌟 录音 HUD 显式操作按钮 (告别无法提前结束的困扰) */
.hud-action-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  width: 100%;
  margin-top: 32rpx;
}

.hud-btn-cancel {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  color: #cbd5e1;
  font-size: 24rpx;
  font-weight: 500;
  border-radius: 38rpx;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hud-btn-cancel:active {
  background: rgba(255, 255, 255, 0.15);
  transform: scale(0.97);
}

.hud-btn-submit {
  flex: 2;
  height: 76rpx;
  line-height: 76rpx;
  background: linear-gradient(135deg, #e5b974 0%, #c49647 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  color: #0b111e;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 38rpx;
  padding: 0 24rpx;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-shadow: 0 8rpx 20rpx rgba(229, 185, 116, 0.35);
}

.hud-btn-submit:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 12rpx rgba(229, 185, 116, 0.2);
}

.btn-sub-ico {
  font-size: 28rpx;
}

/* 🌟 动态答疑专属快捷条 (可随时提前结束答疑并返回正片) */
.dynamic-qa-dock-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(90deg, rgba(229, 185, 116, 0.15) 0%, rgba(30, 41, 59, 0.85) 100%);
  border: 1rpx solid rgba(229, 185, 116, 0.4);
  border-radius: 14rpx;
  padding: 8rpx 16rpx;
  margin-bottom: 6rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
  animation: barSlideDown 0.3s ease-out;
}

@keyframes barSlideDown {
  from { opacity: 0; transform: translateY(-8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.dynamic-dot {
  font-size: 22rpx;
  color: #f59e0b;
  margin-right: 8rpx;
  animation: dotGlow 1.2s infinite alternate;
}

@keyframes dotGlow {
  0% { opacity: 0.6; }
  100% { opacity: 1; }
}

.dynamic-tip {
  flex: 1;
  font-size: 20rpx;
  color: #e2e8f0;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dynamic-skip-btn {
  font-size: 20rpx;
  color: #e5b974;
  font-weight: 700;
  padding: 4rpx 12rpx;
  background: rgba(229, 185, 116, 0.18);
  border-radius: 8rpx;
  white-space: nowrap;
}

.dynamic-skip-btn:active {
  opacity: 0.7;
}

