}

.drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.drawer-main-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #ffffff;
  display: block;
}

.drawer-sub-title {
  font-size: 17rpx;
  color: #94a3b8;
  display: block;
  margin-top: 4rpx;
}

.drawer-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #94a3b8;
