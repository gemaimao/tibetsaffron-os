  gap: 4rpx;
}

.spec-label {
  font-size: 15rpx;
  color: #64748b;
}

.spec-val {
  font-size: 20rpx;
  font-weight: 700;
  color: #f1ede6;
}

.spec-note {
  font-size: 14rpx;
  color: #10b981;
  font-weight: 600;
}

.sheet-footer-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 15rpx;
  color: #94a3b8;
