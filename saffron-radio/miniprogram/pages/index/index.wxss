}

/* ══════════════════════════════════════════════════════════════════
   8. 智识剧场节目单 · 选集抽屉样式 (Episode Catalog Drawer)
   ══════════════════════════════════════════════════════════════════ */
.badge-arrow {
  font-size: 14rpx;
  margin-left: 4rpx;
  opacity: 0.8;
}

.episode-drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(12px);
  z-index: 9999;
