}

/* ══════════════════════════════════════════════════════════════════
   7. 👑 高奢品牌防伪溯源卡片模态窗 (Sheet & Modal)
   ══════════════════════════════════════════════════════════════════ */
.brand-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.82);
  backdrop-filter: blur(8px);
  z-index: 9999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: env(safe-area-inset-bottom);
}

.brand-card-sheet {
  width: 92vw;
  background: linear-gradient(180deg, #161a22 0%, #0c0e12 100%);
  border: 1rpx solid rgba(229, 185, 116, 0.35);
  border-radius: 28rpx 28rpx 20rpx 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 -10rpx 40rpx rgba(0, 0, 0, 0.8), 0 0 24rpx rgba(223, 178, 106, 0.15);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
}

.sheet-gold-glow {
  position: absolute;
  top: -40rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 200rpx;
  height: 80rpx;
  background: radial-gradient(circle, rgba(229, 185, 116, 0.3) 0%, transparent 70%);
  pointer-events: none;
}

.sheet-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.sheet-title-group {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.sheet-sub {
  font-size: 15rpx;
  font-weight: 700;
  color: #dfb26a;
  letter-spacing: 2rpx;
}

.sheet-main {
  font-size: 24rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 0.5rpx;
}

.sheet-close {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
