  display: flex;
  align-items: center;
  justify-content: center;
  color: #94a3b8;
  font-size: 20rpx;
}

.sheet-badge-row {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.sheet-badge {
  font-size: 16rpx;
  color: #cbd5e1;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.gold-badge {
  background: rgba(229, 185, 116, 0.12);
  border-color: rgba(229, 185, 116, 0.35);
  color: #fce7c8;
}

.badge-dot {
  font-size: 12rpx;
  color: #dfb26a;
}

.sheet-specs-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
