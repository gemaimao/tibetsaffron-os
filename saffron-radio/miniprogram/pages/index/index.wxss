  align-items: flex-end;
  justify-content: center;
}

.episode-drawer-sheet {
  width: 100%;
  max-height: 76vh;
  background: #11141b;
  border-top-left-radius: 28rpx;
  border-top-right-radius: 28rpx;
  border: 1rpx solid rgba(229, 185, 116, 0.3);
  padding: 16rpx 24rpx calc(30rpx + env(safe-area-inset-bottom)) 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  box-shadow: 0 -16rpx 48rpx rgba(0, 0, 0, 0.88);
}

.sheet-drag-handle {
