/* 茶室 */

.hero {
  padding: 40rpx 0 8rpx;
}

/* ---------- 隐私门 ---------- */

.gate {
  padding: 36rpx 34rpx 38rpx;
  border-radius: 20rpx;
  background-color: #FFFFFF;
  box-shadow: 0 6rpx 28rpx rgba(62, 56, 53, 0.06);
  border-left: 6rpx solid #8C2B2B;
}

.gate__title {
  font-family: "Songti SC", "STSong", serif;
  font-size: 32rpx;
  font-weight: 600;
  color: #3E3835;
  letter-spacing: 3rpx;
}

.gate__body {
  margin-top: 18rpx;
  font-size: 25rpx;
  line-height: 1.8;
  color: rgba(62, 56, 53, 0.78);
}

.gate__list {
  margin-top: 18rpx;
}

.gate__li {
  font-size: 23rpx;
  line-height: 1.9;
  color: rgba(62, 56, 53, 0.6);
}

.gate__btn {
  margin-top: 32rpx;
}

/* ---------- 状态条 ---------- */

.status {
  margin-top: 32rpx;
  padding: 28rpx 30rpx;
  border-radius: 16rpx;
  background-color: rgba(140, 43, 43, 0.06);
}

.status--cloud {
  background-color: rgba(140, 43, 43, 0.08);
}

.status--warn {
  background-color: rgba(140, 43, 43, 0.1);
}

.status__title {
  font-size: 26rpx;
  color: #8C2B2B;
  letter-spacing: 2rpx;
  font-weight: 600;
}

.status__desc {
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.75;
  color: rgba(62, 56, 53, 0.72);
}

.status__btn {
  margin-top: 24rpx;
}

/* ---------- 消息 ---------- */

.msgs {
  margin-top: 8rpx;
}

.msg {
  margin-top: 32rpx;
  display: flex;
}

.msg--user {
  justify-content: flex-end;
}

.msg--bot {
  justify-content: flex-start;
}

.msg__bubble {
  max-width: 86%;
  padding: 30rpx 32rpx;
  border-radius: 18rpx;
  background-color: #FFFFFF;
  box-shadow: 0 6rpx 24rpx rgba(62, 56, 53, 0.05);
  box-sizing: border-box;
}

.msg__bubble--user {
  background-color: #8C2B2B;
  color: #F8F6F0;
  font-size: 27rpx;
  line-height: 1.75;
}

.msg__text {
  font-size: 27rpx;
  line-height: 1.9;
  color: rgba(62, 56, 53, 0.88);
  word-break: break-word;
}

.msg__quote {
  margin-top: 26rpx;
  padding: 22rpx 26rpx;
  border-left: 4rpx solid #8C2B2B;
  background-color: rgba(140, 43, 43, 0.05);
  border-radius: 0 12rpx 12rpx 0;
}

.msg__quote-text {
  font-family: "Songti SC", "STSong", serif;
  font-size: 28rpx;
  line-height: 1.8;
  color: #8C2B2B;
  letter-spacing: 1rpx;
}

.msg__foot {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 22rpx;
}

.msg__src {
  font-size: 20rpx;
  color: rgba(62, 56, 53, 0.45);
  letter-spacing: 1rpx;
}

.msg__src--cloud {
  color: rgba(140, 43, 43, 0.8);
}

.msg__quoted {
  font-size: 20rpx;
  color: #8C2B2B;
  margin-left: 8rpx;
}

.msg__acts {
  display: flex;
  flex-wrap: wrap;
  margin-top: 22rpx;
}

.msg__act {
  font-size: 22rpx;
  color: #8C2B2B;
  border: 1rpx solid rgba(140, 43, 43, 0.35);
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
  margin-right: 18rpx;
  margin-top: 8rpx;
  letter-spacing: 1rpx;
}

.msg--sys {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.msg__sys-text {
  font-size: 23rpx;
  line-height: 1.8;
  color: rgba(62, 56, 53, 0.6);
  background-color: rgba(62, 56, 53, 0.05);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  width: 100%;
  box-sizing: border-box;
}

.msg__sys-acts {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.msg__act--sys {
  margin-top: 16rpx;
  margin-left: 0;
}

.sending {
  margin-top: 28rpx;
  font-size: 22rpx;
  color: rgba(62, 56, 53, 0.45);
  letter-spacing: 2rpx;
}

/* ---------- 推荐问题 ---------- */

.sugs {
  margin-top: 44rpx;
}

.sugs__list {
  margin-top: 20rpx;
}

.sug {
  font-size: 25rpx;
  color: rgba(62, 56, 53, 0.78);
  background-color: rgba(140, 43, 43, 0.05);
  border-radius: 14rpx;
  padding: 22rpx 26rpx;
  margin-bottom: 16rpx;
  line-height: 1.6;
}

/* ---------- 输入 ---------- */

.composer {
  display: flex;
  align-items: center;
  padding: 14rpx 14rpx 14rpx 32rpx;
  border-radius: 48rpx;
  background-color: #FFFFFF;
  box-shadow: 0 6rpx 28rpx rgba(62, 56, 53, 0.06);
}

.composer__input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  font-size: 27rpx;
  color: #3E3835;
}

.composer__ph {
  color: rgba(62, 56, 53, 0.35);
  font-size: 26rpx;
}

.composer__send {
  flex-shrink: 0;
  height: 72rpx;
  padding: 0 40rpx;
  border-radius: 36rpx;
  background-color: #8C2B2B;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 14rpx;
}

.composer__send-text {
  font-size: 26rpx;
  color: #F8F6F0;
  letter-spacing: 3rpx;
}

.composer__hint {
  margin-top: 16rpx;
  font-size: 21rpx;
  color: rgba(62, 56, 53, 0.45);
  text-align: center;
}

.notice--safety {
  margin-top: 36rpx;
}

/* ---------- 工具 ---------- */

.tools {
  margin-top: 32rpx;
  display: flex;
  justify-content: center;
}

.tools__item {
  font-size: 22rpx;
  color: rgba(62, 56, 53, 0.45);
  letter-spacing: 1rpx;
  padding: 12rpx 24rpx;
}

/* ---------- 离屏画布 ---------- */

.quote-canvas {
  position: fixed;
  top: -9999px;
  left: 0;
  z-index: -1;
}
