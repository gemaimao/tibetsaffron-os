/* ============================================================
   雪域林泉 · 藏红花电台  全局样式
   配色：#F8F6F0 米色底 / #8C2B2B 绛红 / #3E3835 墨色
   风格：优雅米色茶室，大留白
   ============================================================ */

page {
  background-color: #F8F6F0;
  color: #3E3835;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.7;
  letter-spacing: 0.4rpx;
}

.serif {
  font-family: "Songti SC", "STSong", "Noto Serif SC", "Source Han Serif SC", serif;
}

/* ---------------- 布局 ---------------- */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 48rpx 40rpx 0;
}

.page--with-player {
  padding-bottom: 200rpx;
}

.page--plain {
  padding-bottom: 60rpx;
}

.stack-24 > view + view,
.stack-24 > navigator + navigator {
  margin-top: 24rpx;
}

.stack-40 > view + view {
  margin-top: 40rpx;
}

/* ---------------- 文字 ---------------- */

.brand-name {
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
  font-size: 52rpx;
  font-weight: 600;
  color: #3E3835;
  letter-spacing: 8rpx;
  line-height: 1.3;
}

.brand-sub {
  font-size: 24rpx;
  color: #8C2B2B;
  letter-spacing: 6rpx;
  margin-top: 12rpx;
}

.slogan {
  font-size: 26rpx;
  color: rgba(62, 56, 53, 0.6);
  margin-top: 20rpx;
  letter-spacing: 2rpx;
}

.section-title {
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
  font-size: 34rpx;
  font-weight: 600;
  color: #3E3835;
  letter-spacing: 4rpx;
}

.section-sub {
  font-size: 24rpx;
  color: rgba(62, 56, 53, 0.55);
  margin-top: 8rpx;
}

.muted {
  color: rgba(62, 56, 53, 0.55);
  font-size: 24rpx;
}

.accent {
  color: #8C2B2B;
}

.hairline {
  height: 1rpx;
  background-color: rgba(140, 43, 43, 0.16);
}

.hairline--wide {
  margin: 40rpx 0;
}

/* ---------------- 卡片 ---------------- */

.card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 36rpx;
  box-shadow: 0 6rpx 28rpx rgba(62, 56, 53, 0.05);
}

.card--flat {
  background-color: rgba(255, 255, 255, 0.6);
  box-shadow: none;
  border: 1rpx solid rgba(140, 43, 43, 0.1);
}

/* ---------------- 按钮 ---------------- */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  letter-spacing: 3rpx;
  box-sizing: border-box;
  padding: 0 40rpx;
}

.btn::after {
  border: none;
}

.btn-primary {
  background-color: #8C2B2B;
  color: #F8F6F0;
}

.btn-primary--disabled {
  background-color: rgba(140, 43, 43, 0.35);
  color: rgba(248, 246, 240, 0.9);
}

.btn-ghost {
  background-color: transparent;
  color: #8C2B2B;
  border: 1rpx solid rgba(140, 43, 43, 0.45);
}

.btn-quiet {
  background-color: rgba(140, 43, 43, 0.06);
  color: #8C2B2B;
}

.btn-mini {
  height: 60rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  padding: 0 28rpx;
  letter-spacing: 2rpx;
}

/* ---------------- 标签 ---------------- */

.chip {
  display: inline-flex;
  align-items: center;
  height: 56rpx;
  padding: 0 26rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: rgba(62, 56, 53, 0.75);
  background-color: rgba(140, 43, 43, 0.06);
  letter-spacing: 2rpx;
}

.chip--active {
  background-color: #8C2B2B;
  color: #F8F6F0;
}

.tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #8C2B2B;
  background-color: rgba(140, 43, 43, 0.08);
  letter-spacing: 2rpx;
}

/* ---------------- 提示条 ---------------- */

.notice {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  background-color: rgba(140, 43, 43, 0.06);
  font-size: 23rpx;
  color: rgba(62, 56, 53, 0.8);
  line-height: 1.6;
}

.notice__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #8C2B2B;
  margin-top: 14rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.notice__text {
  flex: 1;
}

/* ---------------- 图片占位 ---------------- */

.cover {
  background-color: rgba(140, 43, 43, 0.1);
  border-radius: 16rpx;
  overflow: hidden;
}

/* ---------------- 安全区 ---------------- */

.safe-bottom {
  height: calc(40rpx + env(safe-area-inset-bottom));
}
